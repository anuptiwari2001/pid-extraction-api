# --- App ---
APP_NAME="P&ID Extraction API"
ENV=development
LOG_LEVEL=INFO

# --- Database (pluggable: mssql | postgres | mysql | mongo | neo4j) ---
DATABASE_TYPE=mssql

# --- MSSQL: Option 1 — simple config (recommended for local dev) ---
# Set MSSQL_ENABLED=true and fill these in; the app assembles DATABASE_URL
# from them automatically (see app/core/config.py:_assemble_mssql_url).
# Leave MSSQL_USERNAME/MSSQL_PASSWORD blank to use Windows/trusted
# authentication as the account running the API process.
MSSQL_ENABLED=false
MSSQL_SERVER=localhost
MSSQL_DATABASE=pid_extraction
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# --- MSSQL: Option 2 — a complete SQLAlchemy URL (takes precedence over Option 1) ---
# MSSQL_CONNECTION_STRING="mssql+pyodbc://@MSI/PID_Extract?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"

# DATABASE_URL is what the app actually connects with. It's set for you
# automatically when MSSQL_ENABLED=true (Option 1) or MSSQL_CONNECTION_STRING
# is set (Option 2) above — only edit it directly if you're using a
# non-MSSQL database type:
# Postgres example:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/pid_extraction"
# MySQL example:
# DATABASE_URL="mysql+pymysql://root:root@localhost:3306/pid_extraction"
# Mongo example:
# DATABASE_URL="mongodb://localhost:27017/pid_extraction"

# Neo4j uses a separate bolt URI + auth pair instead of DATABASE_URL
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
USE_CELERY=false

# --- Storage ---
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
CROP_DIR=./storage/crops
RENDER_DPI=300

# --- CV symbol detection ---
# Path to a fine-tuned YOLOv8 .pt file. If missing, a heuristic contour-based
# fallback is used (see app/services/cv/symbol_detector.py) — every
# detection from the fallback is routed through human-in-the-loop labeling.
YOLO_MODEL_PATH=./models_weights/pid_symbols_yolov8.pt
CV_CONFIDENCE_DEFAULT=0.75
CV_DEVICE=cpu

# --- Text extraction ---
OCR_ENGINE=easyocr
# VLM_PROVIDER=none disables vision-language calls entirely (OCR only, and
# the /vlm/analyze* expert-analyst endpoints return a flagged/empty result).
# VLM_PROVIDER=ollama (the default) uses a local Ollama server — no API key.
# VLM_PROVIDER=anthropic / openai use those hosted APIs instead, and DO
# require the matching key below.
VLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VLM_MODEL=claude-sonnet-4-6

# --- Ollama (local VLM — used when VLM_PROVIDER=ollama, no API key needed) ---
# 1. Install Ollama: https://ollama.com
# 2. Pull a vision-capable model, e.g.: ollama pull qwen3-vl:4b
#    (other good options: qwen2.5vl, llama3.2-vision, or llava if VRAM-limited)
# 3. Make sure the server is running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=qwen3-vl:4b
# Raised from Ollama's default 120s — GPU offload (below) should make
# calls fast again, but the first call after a cold start / config change
# still needs headroom to reload the model. Raise further if you still see
# "Read timed out" errors. For dense P&IDs with high num_ctx, increase to
# 1200-1800 seconds (20-30 minutes) on slower hardware or CPU-only systems.
OLLAMA_TIMEOUT_SECONDS=1200
# num_ctx sent explicitly on every call — must cover PROMPT + RESPONSE
# combined. Raise further if you still hit "exceeds the available context
# size" or "no valid/parseable JSON" (the latter usually means the
# response got truncated mid-JSON because too little of num_ctx was left
# for it after the prompt).
OLLAMA_NUM_CTX=12288
# Forces Ollama to try offloading this many layers to GPU instead of
# trusting its own (sometimes overly conservative) VRAM auto-detection,
# which on hybrid-graphics laptops can silently pick 100% CPU. 999 asks
# for "as many as fit"; set to 0 to force pure CPU.
OLLAMA_NUM_GPU=999
OLLAMA_JSON_RETRY_ATTEMPTS=2

# --- Relationship inference ---
# Rule-based inference always runs. USE_GNN=true additionally attempts a
# trained GNN refinement pass — only meaningful once you have trained
# weights at GNN_MODEL_PATH; see app/services/gnn/gnn_model.py.
USE_GNN=false
GNN_MODEL_PATH=./models_weights/pid_relations_gnn.pt

# --- Human-in-the-loop ---
AUTO_LEARN_UNKNOWNS_DEFAULT=false
